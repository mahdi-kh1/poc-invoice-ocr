# ------------------------------------------------------------------
# OCR (Step 1)
# Text is extracted from the image with Tesseract.js (local, free, no
# signup or credit card required) — no env var needed for this part.
# ------------------------------------------------------------------

# ------------------------------------------------------------------
# OpenRouter (Step 1 for structured field extraction from OCR text,
# and Step 2 for expense classification)
# Get an API key here: https://openrouter.ai/keys
# ------------------------------------------------------------------

OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY

# Model to use — always check this page before running to confirm the
# chosen model is still free (the free list changes frequently):
# https://openrouter.ai/models?max_price=0
OPENROUTER_MODEL=openai/gpt-oss-20b:free
