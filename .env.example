# ------------------------------------------------------------------
# Azure Document Intelligence (مرحله ۱: OCR)
# از Azure Portal برو به resource از نوع "Document Intelligence" (یا
# "Form Recognizer" قدیمی) → منوی سمت چپ "Keys and Endpoint".
# ------------------------------------------------------------------

# آدرس endpoint، مثلاً: https://my-resource.cognitiveservices.azure.com
AZURE_DI_ENDPOINT=

# یکی از دو کلید (KEY 1 یا KEY 2)
AZURE_DI_KEY=

# ------------------------------------------------------------------
# OpenRouter (مرحله ۲: دسته‌بندی هزینه)
# کلید API از اینجا بگیر: https://openrouter.ai/keys
# ------------------------------------------------------------------

OPENROUTER_API_KEY=

# مدل مورد استفاده — حتماً قبل از اجرا از این آدرس چک کن که مدل انتخابی
# هنوز رایگانه (لیست رایگان‌ها مدام تغییر می‌کنه):
# https://openrouter.ai/models?max_price=0
OPENROUTER_MODEL=qwen/qwen-2.5-7b-instruct:free
