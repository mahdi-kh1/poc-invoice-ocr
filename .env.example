# ------------------------------------------------------------------
# OCR (Step 1)
# Text is extracted from the image with Tesseract.js (local, free, no
# signup or credit card required) — no env var needed for this part.
# ------------------------------------------------------------------

# ------------------------------------------------------------------
# OpenRouter (Step 1 for structured field extraction from OCR text,
# and Step 2 for expense classification)
# Get an API key here: https://openrouter.ai/keys
# ------------------------------------------------------------------

OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY

# Model to use — always check this page before running to confirm the
# chosen model is still free (the free list changes frequently):
# https://openrouter.ai/models?max_price=0
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Comma-separated fallback models tried in order when OPENROUTER_MODEL is rate-limited,
# overloaded, or returns an unusable response — free-tier models each sit behind their own
# shared rate-limit pool, so this happens routinely under real usage. Uncomment to override the
# built-in default chain (see lib/models.ts); leave commented to use it as-is.
# OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-nano-30b-a3b:free,nvidia/nemotron-nano-9b-v2:free,inclusionai/ling-3.0-tiny:free

# Vision-capable model used only when a user turns on "AI vision assist" in Settings
# (off by default — see lib/settings.ts) for either OCR or Classification. Must
# support image input; the default text model above generally does not.
# Re-check the free list filtered for vision/image input before relying on this:
# https://openrouter.ai/models?max_price=0
OPENROUTER_VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl:free
