# ------------------------------------------------------------------
# OCR (مرحله ۱)
# متن از روی تصویر با Tesseract.js استخراج می‌شه (لوکال، رایگان، بدون
# نیاز به ثبت‌نام یا کارت اعتباری) — نیازی به تنظیم env var نیست.
# ------------------------------------------------------------------

# ------------------------------------------------------------------
# OpenRouter (مرحله ۱ برای استخراج فیلدهای ساختاریافته از متن OCR،
# و مرحله ۲ برای دسته‌بندی هزینه)
# کلید API از اینجا بگیر: https://openrouter.ai/keys
# ------------------------------------------------------------------

OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY

# مدل مورد استفاده — حتماً قبل از اجرا از این آدرس چک کن که مدل انتخابی
# هنوز رایگانه (لیست رایگان‌ها مدام تغییر می‌کنه):
# https://openrouter.ai/models?max_price=0
OPENROUTER_MODEL=openai/gpt-oss-20b:free
